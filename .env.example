# Copy to a private file and run chmod 600 on that file.
# Fill only the keys needed by your chosen models; blank keys are ignored.
# Pass its absolute path with --env-file; it is never loaded automatically.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Gemini in the public TTC preset uses OpenRouter, not a native Google key.
